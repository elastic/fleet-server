{
  "id": "remote-with-secrets",
  "revision": 1,
  "outputs": {
    "default": {
      "type": "elasticsearch",
      "hosts": [
        "https://local.es.example:443"
      ]
    },
    "OUTPUT_ID": {
      "type": "remote_elasticsearch",
      "hosts": [
        "https://remote.es.example:443"
      ],
      "service_token": null,
      "secrets": {
        "service_token": {
          "id": "SERVICE_TOKEN_ID"
        },
        "ssl": {
          "key": {
            "id": "SSL_KEY_ID"
          }
        }
      }
    }
  },
  "output_permissions": {
    "default": {
      "_fallback": {
        "cluster": ["monitor"],
        "indices": [
          {
            "names": ["logs-*", "metrics-*"],
            "privileges": ["auto_configure", "create_doc"]
          }
        ]
      }
    },
    "OUTPUT_ID": {
      "_fallback": {
        "cluster": ["monitor"],
        "indices": [
          {
            "names": ["logs-*", "metrics-*"],
            "privileges": ["auto_configure", "create_doc"]
          }
        ]
      }
    }
  },
  "inputs": [],
  "secret_references": [
    {"id": "SERVICE_TOKEN_ID"},
    {"id": "SSL_KEY_ID"}
  ],
  "agent": {
    "monitoring": {
      "enabled": true,
      "use_output": "OUTPUT_ID",
      "logs": true,
      "metrics": true
    }
  },
  "fleet": {
    "hosts": ["http://localhost:8220"]
  }
}

  {
    "key": "fleet.awsIdentityFederationEnabled",
    "name": "fleet.awsIdentityFederationEnabled",
    "description": "Kill switch for the AWS Identity Federation option in Fleet's var_groups \"Setup Access\" selector. When false, every var_group option with `provider: aws` (the `identity_federation` credential_type option in the aws, aws_bedrock, aws_logs and aws_mq packages) is hidden from the package policy form; the rest of the var_groups experience is unaffected. Existing policies already using identity federation stay editable. Sibling flags for azure/gcp will follow as those packages migrate. Tracking: https://github.com/elastic/ingest-dev/issues/9446\n",
    "value_type": "boolean",
    "variations": [
      true,
      false
    ],
    "apps": [
      "kibana"
    ],
    "environments": {
      "qa": {
        "default": true
      },
      "staging": {
        "default": true
      },
      "production": {
        "default": false,
        "rules": [
          {
            "type": "match",
            "attribute": "organization.is_elastic_staff",
            "operator": "in",
            "values": [
              true
            ],
            "return": true
          },
          {
            "type": "match",
            "attribute": "kibana.key",
            "operator": "in",
            "values": [
              "f2e495ab608d4449ae75233282633642"
            ],
            "return": true
          }
        ]
      }
    }
  },

#!/bin/bash

set -euo pipefail

source .buildkite/scripts/common.sh

JOB_GCS_BUCKET="fleet-server-ci-internal"

export JOB_GCS_BUCKET

# Usage:
#check_if_branch_available "main"
#Returns FILE_EXISTS_IN_REPO=true if the defined branch is available in the DRA snapshots and FILE_EXISTS_IN_REPO=false if not
check_if_branch_available() {
    local branch=${1}
    local url="https://storage.googleapis.com/artifacts-api/snapshots/branches.json"
    local response=$(curl --fail -s "${url}")
    if echo "${response}" | jq -e --arg branch "${branch}" '.branches | any(. == $branch)' > /dev/null 2>&1; then
        export FILE_EXISTS_IN_REPO=true
        echo "FILE_EXISTS_IN_REPO = true"
    else
        export FILE_EXISTS_IN_REPO=false
        echo "FILE_EXISTS_IN_REPO = false"
    fi
}

if [[ "$BUILDKITE_PIPELINE_SLUG" == "fleet-server" ]]; then
  export GO_VERSION=$(cat .go-version)
fi

if [[ "$BUILDKITE_PIPELINE_SLUG" == "fleet-server-package-mbp" ]]; then
  # TODO remove and replace _branch with BUILDKITE_BRANCH after PR tests
  _branch="${DRA_BRANCH:="${BUILDKITE_BRANCH:=""}"}"

  check_if_branch_available "${_branch}"
fi
